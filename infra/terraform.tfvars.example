# Copy to terraform.tfvars (git-ignored) for local runs. CI passes these as TF_VAR_* instead.
region              = "ap-south-1"
ses_sender_email    = "you@example.com"
alarm_email         = "you@example.com"
initial_admin_email = "you@example.com"

